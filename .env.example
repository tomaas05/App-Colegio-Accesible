# Copia este archivo a .env y ajusta los valores. El archivo .env NUNCA se sube a Git.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=True
# Separados por comas. Añade la IP del portátil para probar desde la tablet en la misma Wi-Fi.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

# --- PostgreSQL ---
# Con Docker Compose el host es "db". En instalación nativa, "localhost".
POSTGRES_DB=despega
POSTGRES_USER=despega
POSTGRES_PASSWORD=despega
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Demostración con HTTPS (perfil "demo" de Docker Compose) ---
# Nombre o IP con el que entran los dispositivos de la demo, p. ej. 192.168.1.50
DESPEGA_HOST=localhost
